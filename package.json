{
  "name": "zenite",
  "version": "0.1.0",
  "private": true,
  "description": "Zênite — Aluguel Outdoor",
  "author": "Ana Pinheiro <analuisappena@gmail.com>",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n tsc,vite,electron -c cyan,magenta,green \"npm:dev:types\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:types": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/index.js && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:types && npm run build:renderer",
    "build:types": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.renderer.json --noEmit",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  }
}
