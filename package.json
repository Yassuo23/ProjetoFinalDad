{
  "name": "zenite",
  "version": "0.1.0",
  "private": true,
  "description": "Zênite — Aluguel Outdoor",
  "author": "Ana Pinheiro <analuisappena@gmail.com>",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently -k -n types,preload,vite,electron -c cyan,magenta,blue,green \"npm:dev:types\" \"npm:dev:preload\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "tsc7": "node ./node_modules/typescript7/bin/tsc",
    "dev:types": "npm run tsc7 -- -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js --watch",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 dist/main/index.js dist/preload/index.js && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "build": "npm run build:types && npm run build:preload && npm run build:renderer",
    "build:types": "npm run tsc7 -- -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "typecheck": "npm run tsc7 -- -p tsconfig.renderer.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.74.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
