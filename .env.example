# Stripe — checkout hospedado (somente o processo main lê estas variáveis)
# Use uma chave de TESTE no desenvolvimento. Nunca commite o .env preenchido.
STRIPE_SECRET_KEY=sk_test_SUBSTITUA_PELA_SUA_CHAVE_DE_TESTE
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_MS=10000
STRIPE_MOEDA=brl

# URLs públicas e HTTPS para onde o Stripe redireciona após o checkout.
# Troque example.com pelo domínio real da sua loja.
STRIPE_SUCCESS_URL=https://buy.stripe.com/test_6oU28kaPGd6fff3fha0co00
STRIPE_CANCEL_URL=https://example.com/pagamentos/cancelado

# API de clientes fictícios (aba Clientes). Suba o mock com `npm run mock-api`.
# Somente o processo main lê estas variáveis; o renderer nunca recebe a URL base.
CLIENTES_API_BASE_URL=http://127.0.0.1:3199
CLIENTES_API_TIMEOUT_MS=5000
# Opcional. Se preenchido, o main envia `Authorization: Bearer <token>` e o mock exige o mesmo valor.
CLIENTES_API_TOKEN=
# Usado apenas pelo servidor mock (processo separado), nunca pelo Electron.
CLIENTES_API_PORT=3199
