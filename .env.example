# MySQL / MariaDB connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenite
DB_USER=seu_usuario
DB_PASSWORD=troque-por-sua-senha
DB_SSL=false

# Integrações e regras de negócio (opcionais)
# Sem chave, a confirmação de reserva usa um resumo de clima indisponível.
OPENWEATHER_API_KEY=
# Cidade usada na consulta de clima (padrão: Sao Paulo).
CLIMA_CIDADE=Sao Paulo
# Multa por dia de atraso na devolução (padrão: 20).
MULTA_DIARIA_VALOR=20
