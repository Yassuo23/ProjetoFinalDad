# MySQL / MariaDB connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=zenite
DB_USER=seu_usuario
DB_PASSWORD=troque-por-sua-senha
DB_SSL=false

# Regra de negócio
# Multa por dia de atraso na devolução (padrão: 20). Domingos e feriados
# nacionais não são cobrados; veja docs/integracoes.md.
MULTA_DIARIA_VALOR=20

# Previsão do tempo pela data da reserva (Open-Meteo; docs/adr/0008)
# Sem chave é necessária no tier gratuito. OPENWEATHER_API_KEY não é mais usado.
# Informe as duas coordenadas da loja OU apenas a cidade para geocodificação.
CLIMA_LATITUDE=
CLIMA_LONGITUDE=
CLIMA_CIDADE=Sao Paulo

# ViaCEP, BrasilAPI (CNPJ/feriados) e Open-Meteo não exigem credencial.
# Nunca coloque chaves de API neste arquivo em produção: use o cofre do SO
# ou uma variável de ambiente injetada no processo principal.
